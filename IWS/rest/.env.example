# "sqlite" (padrão, não exige instalar nem configurar nenhum banco) ou "mysql".
DB_BACKEND=sqlite

# --- Usado apenas quando DB_BACKEND=sqlite ---
SQLITE_PATH=./db_pedidos.db

# --- Usado apenas quando DB_BACKEND=mysql ---
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=db_pedidos

# Exigido no header X-API-Key em todas as rotas, exceto /health.
API_KEY=changeme
